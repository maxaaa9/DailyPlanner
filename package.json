{
  "name": "dailyplanner",
  "version": "1.0.0",
  "description": "A daily planning app with task scheduling, notifications, and fitness location features.",
  "author": "DailyPlanner",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "build:apk": "node -e \"require('fs').mkdirSync('android/app/src/main/assets', {recursive: true})\" && npx expo export:embed --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-navigation/bottom-tabs": "^7.15.2",
    "@react-navigation/material-top-tabs": "^7.4.16",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "~55.0.4",
    "expo-file-system": "~55.0.10",
    "expo-image-picker": "~55.0.10",
    "expo-local-authentication": "~55.0.8",
    "expo-location": "~55.1.2",
    "expo-notifications": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "firebase": "^12.10.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-maps": "1.26.20",
    "react-native-screens": "~4.24.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-tab-view": "^4.2.2"
  },
  "private": true,
  "devDependencies": {
    "@react-native-community/cli": "^20.1.2",
    "rimraf": "^6.0.1"
  }
}
